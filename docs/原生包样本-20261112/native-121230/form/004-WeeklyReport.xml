;,&quot;formRules&quot;:[],&quot;fullscreen&quot;:null,&quot;form_item_eidt_mode&quot;:true,&quot;hide_name&quot;:false,&quot;colon&quot;:false,&quot;width&quot;:90,&quot;changeMessage&quot;:&quot;noPrompt&quot;,&quot;customClass&quot;:&quot;pp-drawer-add&quot;,&quot;styles&quot;:{&quot;pageBackground&quot;:&quot;bgColor&quot;,&quot;isRepeat&quot;:&quot;noRepeat&quot;,&quot;PCWidth&quot;:&quot;full&quot;,&quot;shadow&quot;:&quot;N&quot;,&quot;borderSize&quot;:&quot;0&quot;,&quot;isDivider&quot;:&quot;N&quot;,&quot;headerDisplay&quot;:&quot;hidden&quot;,&quot;headerType&quot;:&quot;text&quot;,&quot;headerLayout&quot;:&quot;left&quot;,&quot;headerTypeface&quot;:&quot;default&quot;,&quot;headerFontSize&quot;:&quot;default&quot;,&quot;headerAlignment&quot;:&quot;left&quot;,&quot;titleTypeface&quot;:&quot;default&quot;,&quot;titleFontSize&quot;:&quot;default&quot;,&quot;titleBold&quot;:true,&quot;labelTypeface&quot;:&quot;default&quot;,&quot;labelFontSize&quot;:&quot;default&quot;,&quot;valTypeface&quot;:&quot;default&quot;,&quot;valFontSize&quot;:&quot;default&quot;},&quot;showModal&quot;:false,&quot;marginTop&quot;:null}">
